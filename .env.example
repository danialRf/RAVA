# App
NODE_ENV=development
APP_URL=http://localhost:3000
AUTH_SECRET=replace_me

# Database
# POSTGRES_HOST_PORT sets the host port docker-compose publishes. Change both
# it and the port inside DATABASE_URL if 5432 is unavailable on your machine.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://rava:rava@localhost:5432/rava
# Separate database used by the repository integration tests. It is created and
# dropped by the test setup, so it must not be a database you care about.
TEST_DATABASE_URL=postgresql://rava:rava@localhost:5432/rava_test

# Redis
REDIS_URL=redis://localhost:6379

# Object storage
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=rava-public
S3_BUCKET_PRIVATE=rava-private
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# FX
FX_PROVIDER=fake
FX_FAKE_EUR_TOMAN=200000
FX_API_KEY=
FX_MANUAL_FALLBACK_ENABLED=true

# Payment
PAYMENT_PROVIDER=fake
PAYMENT_MERCHANT_ID=

# SMS
SMS_PROVIDER=fake
SMS_API_KEY=

# Google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Email
EMAIL_PROVIDER=console
SMTP_URL=

# Search
SEARCH_PROVIDER=postgres
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=

# AI (disabled at launch)
AI_PROVIDER=disabled
OPENAI_API_KEY=

